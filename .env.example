# Optional: nur für den KI-Dienst nötig. Datei kopieren zu .env und den Schlüssel des gewünschten Dienstes eintragen.
# Welcher Dienst genutzt wird, wählst du in der App unter Einstellungen.
# Die Datei .env wird nie ins Projektarchiv übernommen (siehe .gitignore).
ANTHROPIC_API_KEY=
# Optional: anderes Claude-Modell (Standard: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: Port (Standard 5173)
# PORT=5173

# ChatGPT (OpenAI API, platform.openai.com): Schlüssel eintragen, um ChatGPT statt Claude zu nutzen
OPENAI_API_KEY=
# Optional: anderes OpenAI-Modell (Standard: gpt-6.1-sol)
# OPENAI_MODEL=gpt-6.1-sol
